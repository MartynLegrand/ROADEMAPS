# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jestfly
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production

# API Configuration
API_BASE_URL=http://localhost:3000

# Service URLs (for Gateway)
AUTH_SERVICE_URL=http://localhost:3001
USERS_SERVICE_URL=http://localhost:3002
NOTIFICATIONS_SERVICE_URL=http://localhost:3003
WALLET_SERVICE_URL=http://localhost:3004
COMMUNITY_SERVICE_URL=http://localhost:3005
CONTENT_SERVICE_URL=http://localhost:3006
STORE_SERVICE_URL=http://localhost:3007
NFT_SERVICE_URL=http://localhost:3008
CAREER_SERVICE_URL=http://localhost:3009
STREAMING_SERVICE_URL=http://localhost:3010
ANALYTICS_SERVICE_URL=http://localhost:3011
ADMIN_SERVICE_URL=http://localhost:3012

# Storage Configuration
STORAGE_PROVIDER=s3
STORAGE_BUCKET=jestfly-uploads
STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Email Configuration
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@jestfly.com

# Streaming Configuration
RTMP_URL=rtmp://localhost:1935
HLS_URL=http://localhost:8080

# Blockchain Configuration
BLOCKCHAIN_NETWORK=polygon
BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here

# Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info
